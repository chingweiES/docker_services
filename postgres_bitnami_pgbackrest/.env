# Non-sensitive configuration only.
# ⚠️  Do NOT store passwords, tokens, or keys here — use secrets/ files instead:
#       secrets/db_password.txt       → PostgreSQL superuser password
#       secrets/repl_password.txt     → Replication user password (currently EMPTY — fill this in!)
#       secrets/pgbackrest_cipher.txt → pgbackrest AES-256 passphrase (generate with:
#                                         echo "$(openssl rand -base64 32)" > secrets/pgbackrest_cipher.txt)

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=bitnami_pgbackrest_db
REPL_USER=replicator

# ── Replica connection to Primary ─────────────────────────────────────────────
# Same host (Docker network): keep as container name
# Different host:            set to primary server's IP or FQDN
PRIMARY_HOST=pg-primary
PRIMARY_PORT=8009
